{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>olcond/renovate-config",
    // Picks up `# renovate: datasource=… depName=…` comments above *_VERSION
    // env vars in workflows (currently govulncheck). The shared preset does not
    // include it, so without this the pinned tool versions would never be
    // bumped and would silently rot.
    "customManagers:githubActionsVersions"
  ],
  "packageRules": [
    {
      "description": "go.mod replace pins the fork's bridge-integration branch (carries MDT patches); Renovate digest updates follow the fork's default 'dev' branch and would silently drop those patches",
      "matchPackageNames": ["github.com/volschin/eebus-go"],
      "enabled": false
    }
  ]
}
